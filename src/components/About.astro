---
/*
 * Datos de la franja inferior. Las posiciones (left/top) son las del Figma,
 * relativas a la caja; `left` ya está restado del inicio de su columna.
 * `angle` es el ángulo del Figma (positivo = antihorario); en CSS se invierte.
 */
const facts = [
	{
		title: 'Origen',
		notes: [
			{ text: 'Buenos Aires,', left: -1.17, top: 71.52, width: 171.75, angle: 1.5 },
			{ text: 'Argentina.', left: -0.08, top: 114.25, width: 135.42, angle: 1.5 },
		],
	},
	{
		title: 'Formación',
		notes: [
			{ text: 'Escuela ORT,', left: -0.04, top: 76.01, width: 168.4, angle: -1 },
			{ text: 'orientación TIC.', left: -0.77, top: 117.8, width: 212.17, angle: -1 },
		],
	},
	{
		title: 'Trayectoria',
		notes: [
			{ text: 'Diseño de páginas', left: -0.78, top: 72.02, width: 228.59, angle: 1 },
			{ text: 'web y juegos.', left: -0.05, top: 114.99, width: 161.25, angle: 1 },
		],
	},
	{
		title: 'Próximo paso',
		notes: [{ text: 'La arquitectura.', left: -0.6, top: 76.01, width: 209.48, angle: -1.5 }],
	},
];
---

<section id="sobre-mi">
	<div class="about">
		<div class="top">
			<div class="heading">
				<p class="eyebrow">Sobre mí</p>
				<h2 class="title">De diseñar<br />pantallas<br />a diseñar<br />espacios.</h2>
			</div>

			<p class="bio">
				Nací en Buenos Aires y estudié en la Escuela ORT, en la orientación TIC. Hasta ahora mi
				camino fue diseñar páginas web y juegos: espacios digitales pensados para que alguien los
				recorra. Ahora que egreso, quiero llevar ese diseño al mundo real y dedicarme a la
				arquitectura, con proyectos de base elegante que se sientan cuidados en cada detalle.
			</p>
		</div>

		<div class="facts">
			{
				facts.map((fact) => (
					<div class="fact">
						<h3 class="fact-title">{fact.title}</h3>
						{fact.notes.map((note) => (
							<p
								class="note"
								style={`left:calc(${note.left} * var(--u));top:calc(${note.top} * var(--u));width:calc(${note.width} * var(--u));transform:rotate(${-note.angle}deg)`}
							>
								{note.text}
							</p>
						))}
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	section {
		background: var(--bg-slate);
		/* Figma: el primer texto arranca a 120px del borde superior de la sección */
		padding-block: calc(120 * var(--u));
		box-sizing: border-box;
	}

	.about {
		width: var(--content-width);
		margin-inline: auto;
	}

	/* ---- Arriba: titular a la izquierda, texto a la derecha ---- */
	.top {
		display: grid;
		grid-template-columns: calc(660 * var(--u)) 1fr;
	}

	.eyebrow {
		height: calc(18 * var(--u));
		margin: 0;
		display: flex;
		align-items: center;
		font-family: var(--font-body);
		font-weight: 500;
		font-size: calc(12 * var(--u));
		line-height: 1;
		letter-spacing: 0.3em; /* 3.6px / 12px */
		text-transform: uppercase;
		color: var(--heading);
	}

	.title {
		margin: calc(22 * var(--u)) 0 0; /* eyebrow top 120 + 18 -> título top 160 */
		min-height: calc(323.19 * var(--u)); /* alto de la caja en el Figma */
		display: flex;
		align-items: center;
		font-family: var(--font-logo);
		font-weight: 400;
		font-size: min(calc(76.5 * var(--u)), 18vw);
		line-height: 1.0205; /* 78.07 / 76.5 */
		white-space: nowrap;
		color: #efeae0;
	}

	.bio {
		max-width: calc(474.56 * var(--u));
		min-height: calc(183.5 * var(--u));
		margin: calc(171.25 * var(--u)) 0 0; /* 291.25 - 120 */
		display: flex;
		align-items: center;
		font-family: var(--font-body);
		font-weight: 300;
		font-size: calc(18 * var(--u));
		line-height: 1.75; /* 31.5 / 18 */
		color: var(--text);
	}

	/* ---- Abajo: caja con 4 columnas ---- */
	.facts {
		margin-top: calc(91.06 * var(--u)); /* 574.25 - (160 + 323.19) */
		border-top: 1px solid #efeae038;
		display: grid;
		grid-template-columns: repeat(3, calc(294 * var(--u))) 1fr;
	}

	.fact {
		position: relative;
		height: calc(161.59 * var(--u)); /* 162.59 de la caja - 1px de borde */
	}

	.fact-title {
		position: absolute;
		top: calc(41 * var(--u));
		left: 0;
		height: calc(18 * var(--u));
		margin: 0;
		display: flex;
		align-items: center;
		font-family: var(--font-body);
		font-weight: 500;
		font-size: calc(12 * var(--u));
		line-height: 1;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--heading);
	}

	.note {
		position: absolute;
		height: calc(47 * var(--u));
		margin: 0;
		display: flex;
		align-items: center;
		white-space: nowrap;
		font-family: var(--font-hand);
		font-weight: 300; /* Caveat arranca en 400: se ve como Regular */
		font-size: calc(38 * var(--u));
		line-height: 1.1; /* 41.8 / 38 */
		color: #efeae0;
	}

	/* ---- Pantallas más angostas ---- */
	@media (max-width: 1180px) {
		.top {
			grid-template-columns: 1fr;
		}

		.bio {
			margin-top: calc(40 * var(--u));
		}

		.facts {
			grid-template-columns: repeat(2, calc(294 * var(--u)));
			justify-content: space-between;
		}
	}

	@media (max-width: 700px) {
		.facts {
			grid-template-columns: 1fr;
		}
	}
</style>
