---
import { Image } from 'astro:assets';
import residencia from '../assets/referencias/Residencia moderna al atardecer con piscina iluminada.png';
import sala from '../assets/referencias/Sala amplia con ventanales y vista a la montaña.png';
import pasillo from '../assets/referencias/Pasillo con muro de piedra e iluminación lineal.png';
import bano from '../assets/referencias/Baño en piedra oscura con espejo circular iluminado.png';
import cocina from '../assets/referencias/Cocina oscura con isla de mármol.png';
import lago from '../assets/referencias/Lago y montañas al atardecer.png';

// Alto de cada imagen en el Figma (px). `nameWidth` fuerza el corte de línea del texto.
const references = [
	{
		id: 'residencia',
		image: residencia,
		alt: 'Residencia moderna al atardecer con piscina iluminada',
		name: 'Residencia con piscina',
		category: 'Exterior',
		height: 710,
	},
	{
		id: 'sala',
		image: sala,
		alt: 'Sala amplia con ventanales y vista a la montaña',
		name: 'Sala con vista a la montaña',
		category: 'Interior',
		height: 340,
	},
	{
		id: 'pasillo',
		image: pasillo,
		alt: 'Pasillo con muro de piedra e iluminación lineal',
		name: 'Muro de piedra',
		category: 'Material',
		height: 260,
	},
	{
		id: 'bano',
		image: bano,
		alt: 'Baño en piedra oscura con espejo circular iluminado',
		name: 'Baño en piedra oscura',
		nameWidth: 162.83,
		category: 'Detalle',
		height: 260,
	},
	{
		id: 'cocina',
		image: cocina,
		alt: 'Cocina oscura con isla de mármol',
		name: 'Isla de mármol',
		category: 'Detalle',
		height: 380,
	},
	{
		id: 'lago',
		image: lago,
		alt: 'Lago y montañas al atardecer',
		name: 'Atardecer en el lago',
		category: 'Referencia',
		height: 380,
	},
];
---

<section id="referencias">
	<div class="references">
		<header class="intro">
			<p class="eyebrow">Referencias</p>
			<h2 class="title">Lo que me inspira</h2>
			<p class="lead">Imágenes que marcan el rumbo de la arquitectura que quiero hacer.</p>
		</header>

		{
			[references.slice(0, 4), references.slice(4)].map((group, index) => (
				<div class={`gallery ${index === 0 ? 'gallery-top' : 'gallery-bottom'}`}>
					{group.map((item) => (
						<figure class={`card card-${item.id}`} style={`--img-h:${item.height}`}>
							<Image class="card-image" src={item.image} alt={item.alt} />
							<figcaption>
								<span
									class="name"
									style={item.nameWidth ? `max-width:calc(${item.nameWidth} * var(--u))` : undefined}
								>
									{item.name}
								</span>
								<span class="category">{item.category}</span>
							</figcaption>
						</figure>
					))}
				</div>
			))
		}
	</div>
</section>

<style>
	section {
		background: var(--bg-dark);
		/* Figma: el primer texto arranca a 120px del borde superior de la sección */
		padding-block: calc(120 * var(--u));
		box-sizing: border-box;
	}

	.references {
		width: var(--content-width);
		margin-inline: auto;
	}

	/* ---- Cabecera de la sección ---- */
	.eyebrow,
	.category {
		font-family: var(--font-body);
		font-weight: 500;
		text-transform: uppercase;
		color: var(--heading);
		line-height: 1;
	}

	.eyebrow {
		height: calc(18 * var(--u));
		margin: 0;
		display: flex;
		align-items: center;
		font-size: calc(12 * var(--u));
		letter-spacing: 0.3em; /* 3.6px / 12px */
	}

	.title {
		min-height: calc(89 * var(--u));
		margin: calc(22 * var(--u)) 0 0; /* eyebrow 120 + 18 -> título 160 */
		display: flex;
		align-items: center;
		font-family: var(--font-logo);
		font-weight: 400;
		font-size: min(calc(76.5 * var(--u)), 12vw);
		line-height: 1.0205; /* 78.07 / 76.5 */
		color: #efeae0;
	}

	.lead {
		max-width: calc(525.84 * var(--u));
		min-height: calc(31.5 * var(--u));
		margin: calc(19.06 * var(--u)) 0 0; /* 249 -> 268.06 */
		display: flex;
		align-items: center;
		font-family: var(--font-body);
		font-weight: 300;
		font-size: calc(18 * var(--u));
		line-height: 1.75; /* 31.5 / 18 */
		color: var(--text);
	}

	/* ---- Galería ----
	   Arriba: columnas 460.73 | 313.63 | 313.64 (24px entre columnas), filas 383 y 330
	   (40px entre filas); la imagen de la izquierda ocupa las dos filas.
	   Abajo: columnas 667.2 | 444.8, una sola fila de 423. */
	.gallery {
		display: grid;
		column-gap: calc(24 * var(--u));
		row-gap: calc(40 * var(--u));
	}

	.gallery-top {
		grid-template-columns: 460.73fr 313.63fr 313.64fr;
		grid-template-rows: calc(383 * var(--u)) calc(330 * var(--u));
		margin-top: calc(72 * var(--u)); /* 299.56 -> 371.56 */
	}

	.gallery-bottom {
		grid-template-columns: 667.2fr 444.8fr;
		grid-template-rows: calc(423 * var(--u));
		margin-top: calc(40 * var(--u)); /* 1124.56 -> 1164.56 */
	}

	.card-residencia {
		grid-column: 1;
		grid-row: 1 / 3;
	}

	.card-sala {
		grid-column: 2 / 4;
		grid-row: 1;
	}

	.card-pasillo {
		grid-column: 2;
		grid-row: 2;
	}

	.card-bano {
		grid-column: 3;
		grid-row: 2;
	}

	.card {
		margin: 0;
		min-width: 0;
	}

	.card-image {
		display: block;
		width: 100%;
		height: calc(var(--img-h) * var(--u));
		object-fit: cover;
	}

	figcaption {
		position: relative;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		column-gap: calc(16 * var(--u));
		margin-top: calc(16 * var(--u)); /* imagen 710 -> textos 726 */
	}

	.name {
		display: block;
		min-height: calc(27 * var(--u));
		font-family: var(--font-logo);
		font-weight: 400;
		font-size: calc(22.4 * var(--u));
		line-height: calc(27 * var(--u));
		color: #efeae0;
	}

	.category {
		flex: none;
		display: flex;
		align-items: center;
		height: calc(16 * var(--u));
		margin-top: calc(9 * var(--u));
		font-size: calc(11 * var(--u));
		letter-spacing: 0.28em; /* 3.08px / 11px */
		white-space: nowrap;
	}

	/* ---- Pantallas más angostas ---- */
	@media (max-width: 1180px) {
		.gallery-top,
		.gallery-bottom {
			grid-template-columns: 1fr;
			grid-template-rows: none;
		}

		.card-residencia,
		.card-sala,
		.card-pasillo,
		.card-bano,
		.card-cocina,
		.card-lago {
			grid-column: 1;
			grid-row: auto;
		}

		.card-image {
			height: auto;
			aspect-ratio: 4 / 3;
		}

		.name {
			max-width: none !important;
		}
	}
</style>
