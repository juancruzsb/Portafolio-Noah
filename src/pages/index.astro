---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const sections = [
	{ id: 'inicio', name: '1. Introducción', bg: 'var(--bg-dark)' },
	{ id: 'sobre-mi', name: '2. Sobre mí', bg: 'var(--bg-slate)' },
	{ id: 'proyectos', name: '3. Proyectos', bg: 'var(--bg-dark)' },
	{ id: 'filosofia', name: '4. Filosofía', bg: 'var(--bg-light)', light: true },
	{ id: 'referencias', name: '5. Referencias', bg: 'var(--bg-dark)' },
	{ id: 'materialidad', name: '6. Materialidad', bg: 'var(--bg-slate)' },
	{ id: 'contacto', name: '7. Contacto', bg: 'var(--bg-brown)' },
];
---

<Layout title="Portfolio">
	<Header />
	<main>
		{
			sections.map((section) => (
				<section
					id={section.id}
					class:list={{ 'on-light': section.light }}
					style={`background:${section.bg}`}
				>
					<h2>{section.name}</h2>
				</section>
			))
		}
	</main>
	<Footer />
</Layout>

<style>
	section {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		scroll-margin-top: 3rem;
	}
	h2 {
		margin: 0;
		font-size: 2rem;
		font-weight: 400;
	}
</style>
